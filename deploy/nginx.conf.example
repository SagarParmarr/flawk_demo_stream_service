# Replace the hostname and certificate paths before installing this template.
server {
    listen 443 ssl http2;
    server_name demo-stream.example.com;
    ssl_certificate /etc/letsencrypt/live/demo-stream.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo-stream.example.com/privkey.pem;

    client_max_body_size 32k;
    location / {
        proxy_pass http://127.0.0.1:4180;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
}
