NODE_ENV=production
HOST=127.0.0.1
PORT=4180
LARAVEL_API_BASE_URL=https://devcms.flawkai.com
GO_LIVE_API_BASE_URL=https://kn8v02u2g1.execute-api.us-east-1.amazonaws.com
DEMO_STREAM_SERVICE_SECRET=
GO_LIVE_ADAPTIVE_INTERNAL_SECRET=
ADAPTIVE_DEFAULT_ASSET_S3_URI=s3://flawk/flawk_cms/adaptive_assets/Flawk_log.mp4
DATABASE_PATH=/var/lib/flawk-demo/demo.sqlite
ASSET_CACHE_DIRECTORY=/var/cache/flawk-demo/assets
FFMPEG_PATH=ffmpeg
DEMO_PERSISTENT_PUBLISHER_ENABLED=false
DEMO_PERSISTENT_PUBLISHER_PATH=./native/build/flawk-publisher
# Separate prepared v2 default; keeps the legacy default available for rollback.
# DEMO_PERSISTENT_DEFAULT_ASSET_S3_URI=<prepared-v2-default-S3-URI>
FFPROBE_PATH=ffprobe
AWS_PATH=aws
POLL_INTERVAL_MS=2000
HEARTBEAT_INTERVAL_MS=30000
MAX_DEMO_DURATION_MS=1800000

# Selected window after takeover (legacy) or output commit (persistent), 20–30 seconds.
SELECTED_ASSET_HOLD_SECONDS=30

# Optional for BASIC/STANDARD IVS channels only; verify channel type before enabling.
# IVS_INGEST_KEYFRAME_INTERVAL_SECONDS=2
