{
  "name": "flawk-demo-stream-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file=.env --watch --import tsx src/server.ts",
    "start": "node --env-file=.env --watch --import tsx src/server.ts",
    "start:prod": "node --experimental-sqlite dist/src/server.js",
    "media:dev": "node --env-file=.env.media --import tsx src/media-worker.ts",
    "media:prod": "node dist/src/media-worker.js",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.media --experimental-sqlite --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fastify": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
