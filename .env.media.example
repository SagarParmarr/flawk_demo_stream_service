NODE_ENV=production
LARAVEL_API_BASE_URL=https://devcms.flawkai.com
DEMO_STREAM_SERVICE_SECRET=
# Must match Laravel's configured S3 disk bucket. The instance role supplies credentials.
MEDIA_OUTPUT_BUCKET=flawk
# Comma-separated allowlist; add a separate original/default bucket only if needed.
MEDIA_SOURCE_BUCKETS=flawk
MEDIA_WORK_DIRECTORY=/var/cache/flawk-media/preparation
MEDIA_POLL_INTERVAL_MS=2000
MEDIA_ENCODER_THREADS=2
# Use absolute paths for a custom build. On the EC2 host:
# FFMPEG_PATH=/opt/flawk-ffmpeg/8.1/bin/ffmpeg
# FFPROBE_PATH=/opt/flawk-ffmpeg/8.1/bin/ffprobe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AWS_PATH=aws
LOG_LEVEL=info
